# SETU Sentinel Environment Variables
# Copy this file to .env and adjust the values as needed.

# PostgreSQL Database Configuration
# Format: postgresql+asyncpg://username:password@localhost:5432/database_name
DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/setu_db

# Other Overrides (Optional)
# CAMERA_HOST_IP=127.0.0.1
# KAFKA_BROKER_URL=127.0.0.1:9092
# REDIS_URL=redis://127.0.0.1:6379/0
